---
import { profile } from '@/data/profile'

interface Props {
  title: string
  description: string
  type?: 'website' | 'article'
  publishedTime?: Date | string
  noindex?: boolean
}

const { title, description, type = 'website', publishedTime, noindex = false } = Astro.props
const pageTitle = `${title} — ${profile.name}`
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href
const datePublished = publishedTime
  ? (publishedTime instanceof Date ? publishedTime : new Date(publishedTime)).toISOString()
  : undefined
const article = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished,
  author: { '@type': 'Person', name: profile.name },
  url: canonical,
  mainEntityOfPage: canonical,
} : undefined
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:type" content={type} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:url" content={canonical} />
{type === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
{article && <script type="application/ld+json" set:html={JSON.stringify(article).replace(/</g, '\\u003c')} />}
