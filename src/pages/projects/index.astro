---
import { getCollection } from 'astro:content'
import { ArrowUpRight } from '@lucide/vue'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumb from '@/components/Breadcrumb.astro'
import { Badge } from '@/components/ui/badge'
import { profile } from '@/data/profile'
import { t } from '@/i18n/utils'
import ProjectGallery from '@/components/ProjectGallery.vue'
import { getLinkPreview } from '@/lib/link-preview.mjs'
import { sitePath } from '@/lib/site-path'
import { getProjectImages } from '@/lib/project-images.mjs'

const projects = (await getCollection('projects')).sort((a, b) => b.data.date - a.data.date)
const previews = await Promise.all(projects.map(project =>
  Promise.all([...new Set([project.data.link, project.data.repo].filter(Boolean))].map(url => getLinkPreview(url)))
))
const galleries = projects.map(getProjectImages)
---

<BaseLayout title="專案" description={`${profile.name} 的開發專案，包含專案介紹、使用技術與公開的程式碼或展示連結。`}>
  <div class="projects">
    <div class="projects__pane term-pane">
      <Breadcrumb items={[{ label: '~', href: '/' }, { label: 'projects' }]} />

      <p class="projects__prompt reveal" style="--i: 0">
        {profile.handle}@{profile.hostname}:~$ ls -la ~/projects
      </p>

      <ul class="projects__list">
        {
          projects.map((project, i) => (
            <li class="projects__item reveal" style={`--i: ${i + 1}`}>
              <div class="projects__header">
                <h2 class="projects__title">{project.data.title}</h2>
                <span class="projects__date">{project.data.date.toISOString().slice(0, 10)}</span>
              </div>
              <p class="projects__description">{project.data.description}</p>
              {galleries[i].length > 0 && (
                <ProjectGallery
                  client:load
                  title={project.data.title}
                  images={galleries[i].map(image => ({
                    ...image,
                    src: image.src.startsWith('/') ? sitePath(image.src) : image.src,
                  }))}
                />
              )}
              {project.data.stack.length > 0 && (
                <div class="projects__stack">
                  {project.data.stack.map((tech) => (
                    <Badge variant="outline" class="projects__tech">
                      {tech}
                    </Badge>
                  ))}
                </div>
              )}
              <div class="projects__links">
                {previews[i].map(preview => (
                  <a href={preview.url} class="projects__embed" target="_blank" rel="noopener noreferrer">
                    <span class="projects__embed-body">
                      <span class="projects__embed-host">{preview.hostname} <ArrowUpRight size={14} aria-hidden="true" /></span>
                      <strong class="projects__embed-title">{preview.title || project.data.title}</strong>
                      <span class="projects__embed-description">{preview.description || project.data.description}</span>
                    </span>
                    {preview.image && <img class="projects__embed-image" src={preview.image} alt="" loading="lazy" decoding="async" />}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>

      {projects.length === 0 && (
        <p class="projects__empty" data-i18n="projects.empty">
          {t('projects.empty')}
        </p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .projects {
    padding: clamp(var(--space-lg), 5vw, var(--space-2xl)) clamp(var(--space-md), 4vw, var(--space-xl));
    display: flex;
    justify-content: center;
  }

  .projects__pane {
    width: 100%;
    max-width: 48rem;
    padding: clamp(var(--space-lg), 4vw, var(--space-xl));
  }

  .projects__prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0 0 var(--space-lg);
  }

  .projects__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .projects__item {
    padding: var(--space-lg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .projects__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin: 0 0 var(--space-xs);
  }

  .projects__title {
    min-width: 0;
    flex: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-ink);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .projects__date {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .projects__description {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-sm);
  }

  .projects__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-sm);
  }

  .projects__stack :global(.projects__tech) {
    font-family: var(--font-mono);
    border-radius: var(--radius);
  }

  .projects__links {
    display: grid;
    gap: var(--space-sm);
  }

  .projects__embed {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm);
    border-inline-start: 3px solid var(--color-ink-2);
    border-radius: var(--radius);
    background: var(--color-paper-3);
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .projects__embed-body {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: var(--space-2xs);
  }

  .projects__embed-host {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .projects__embed-title {
    font-size: var(--text-base);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .projects__embed-description {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .projects__embed-image {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    flex-shrink: 0;
    border-radius: var(--radius);
  }

  .projects__embed:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .projects__embed:hover .projects__embed-title {
      text-decoration-thickness: 2px;
    }
  }

  @media (max-width: 30rem) {
    .projects__item {
      padding: var(--space-sm);
    }

    .projects__embed {
      flex-wrap: wrap;
    }

    .projects__embed-body {
      flex-basis: 100%;
    }

    .projects__embed-image {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  .projects__empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
