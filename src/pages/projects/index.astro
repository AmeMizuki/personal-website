---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumb from '@/components/Breadcrumb.astro'
import { Badge } from '@/components/ui/badge'
import { profile } from '@/data/profile'
import { t } from '@/i18n/utils'

const projects = (await getCollection('projects')).sort((a, b) => b.data.date - a.data.date)
---

<BaseLayout title="~/projects">
  <div class="projects">
    <div class="projects__pane term-pane">
      <Breadcrumb items={[{ label: '~', href: '/' }, { label: 'projects' }]} />

      <p class="projects__prompt reveal" style="--i: 0">
        {profile.handle}@{profile.hostname}:~$ ls -la ~/projects
      </p>

      <ul class="projects__list">
        {
          projects.map((project, i) => (
            <li class="projects__item reveal" style={`--i: ${i + 1}`}>
              <div class="projects__header">
                <h2 class="projects__title">{project.data.title}</h2>
                <span class="projects__date">{project.data.date.toISOString().slice(0, 10)}</span>
              </div>
              <p class="projects__description">{project.data.description}</p>
              {project.data.stack.length > 0 && (
                <div class="projects__stack">
                  {project.data.stack.map((tech) => (
                    <Badge variant="outline" class="projects__tech">
                      {tech}
                    </Badge>
                  ))}
                </div>
              )}
              <div class="projects__links">
                {project.data.link && (
                  <a href={project.data.link} class="projects__link" target="_blank" rel="noopener">
                    demo →
                  </a>
                )}
                {project.data.repo && (
                  <a href={project.data.repo} class="projects__link" target="_blank" rel="noopener">
                    repo →
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      {projects.length === 0 && (
        <p class="projects__empty" data-i18n="projects.empty">
          {t('projects.empty')}
        </p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .projects {
    padding: clamp(var(--space-lg), 5vw, var(--space-2xl)) clamp(var(--space-md), 4vw, var(--space-xl));
    display: flex;
    justify-content: center;
  }

  .projects__pane {
    width: 100%;
    max-width: 48rem;
    padding: clamp(var(--space-lg), 4vw, var(--space-xl));
  }

  .projects__prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0 0 var(--space-lg);
  }

  .projects__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .projects__item {
    padding: var(--space-lg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .projects__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin: 0 0 var(--space-xs);
  }

  .projects__title {
    min-width: 0;
    flex: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-ink);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .projects__date {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .projects__description {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-sm);
  }

  .projects__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-sm);
  }

  .projects__stack :global(.projects__tech) {
    font-family: var(--font-mono);
    border-radius: var(--radius);
  }

  .projects__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .projects__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .projects__link:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .projects__empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
