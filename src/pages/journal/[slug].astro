---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumb from '@/components/Breadcrumb.astro'
import { profile } from '@/data/profile'
import { t } from '@/i18n/utils'

export async function getStaticPaths() {
  const entries = (await getCollection('journal')).sort((a, b) => b.data.date - a.data.date)
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }))
}

const { entry, newer, older } = Astro.props
const { Content, headings } = await render(entry)

const toc = headings.filter((h) => h.depth <= 3)

const CHARS_PER_MINUTE = 400 // rough reading speed for CJK prose
const strippedBody = entry.body.replace(/```[\s\S]*?```/g, '').replace(/[#*_>`[\]()-]/g, '')
const readingMinutes = Math.max(1, Math.round(strippedBody.length / CHARS_PER_MINUTE))
---

<BaseLayout title={`~/journal/${entry.id}`}>
  <div class="entry">
    <div class="entry__pane term-pane">
      <Breadcrumb
        items={[{ label: '~', href: '/' }, { label: 'journal', href: '/journal' }, { label: entry.data.title }]}
      />

      <p class="entry__prompt reveal" style="--i: 0">
        {profile.handle}@{profile.hostname}:~$ cat ~/journal/{entry.id}.md
      </p>
      <h1 class="entry__title reveal" style="--i: 1">{entry.data.title}</h1>
      <p class="entry__date reveal" style="--i: 2">
        {entry.data.date.toISOString().slice(0, 10)}
        <span class="entry__date-sep">·</span>
        <span data-i18n="journal.readingTime" data-i18n-vars={JSON.stringify({ min: readingMinutes })}>
          {t('journal.readingTime', { min: readingMinutes })}
        </span>
      </p>

      {toc.length > 0 && (
        <nav
          class="entry__toc reveal"
          style="--i: 3"
          aria-label={t('journal.tocLabel')}
          data-i18n="journal.tocLabel"
          data-i18n-attr="aria-label"
        >
          <p class="entry__toc-heading"># toc</p>
          <ul class="entry__toc-list">
            {toc.map((heading) => (
              <li class={`entry__toc-item entry__toc-item--depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="entry__body reveal" style={`--i: ${toc.length > 0 ? 4 : 3}`}>
        <Content />
      </div>

      <nav class="entry__pager" aria-label={t('journal.pagerNav')} data-i18n="journal.pagerNav" data-i18n-attr="aria-label">
        {older ? (
          <a href={`/journal/${older.id}`} class="entry__pager-link entry__pager-link--older">
            <span class="entry__pager-label" data-i18n="journal.pagerOlder">{t('journal.pagerOlder')}</span>
            <span class="entry__pager-title">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer ? (
          <a href={`/journal/${newer.id}`} class="entry__pager-link entry__pager-link--newer">
            <span class="entry__pager-label" data-i18n="journal.pagerNewer">{t('journal.pagerNewer')}</span>
            <span class="entry__pager-title">{newer.data.title}</span>
          </a>
        ) : <span />}
      </nav>

      <a href="/journal" class="entry__back">← cd ..</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '@/i18n/utils'

  // Astro's view-transition router swaps this page's DOM on client-side nav without
  // re-running a plain top-level script against the new nodes — rebind on every load.
  function setup() {
    const blocks = document.querySelectorAll('.entry__body pre:not([data-copy-ready])')

    // Inline lucide "copy" / "check" icon markup (matches the @lucide/vue icons used
    // elsewhere in the site) — this button is plain DOM, not a Vue island, so the SVG
    // is inlined directly rather than pulling in a whole component for one icon swap.
    const ICON_COPY =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>'
    const ICON_CHECK =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'

    blocks.forEach((pre) => {
      pre.dataset.copyReady = 'true'

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'entry__copy-btn'
      button.innerHTML = ICON_COPY
      button.setAttribute('aria-label', t('journal.copyLabel'))
      button.dataset.i18n = 'journal.copyLabel'
      button.dataset.i18nAttr = 'aria-label'

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '')
          button.innerHTML = ICON_CHECK
          button.classList.remove('entry__copy-btn--error')
          button.setAttribute('aria-label', t('journal.copiedLabel'))
        } catch {
          button.innerHTML = ICON_COPY
          button.classList.add('entry__copy-btn--error')
          button.setAttribute('aria-label', t('journal.copyFailedLabel'))
        }
        setTimeout(() => {
          button.innerHTML = ICON_COPY
          button.classList.remove('entry__copy-btn--error')
          button.setAttribute('aria-label', t('journal.copyLabel'))
        }, 1500)
      })

      pre.appendChild(button)
    })
  }

  document.addEventListener('astro:page-load', setup)
</script>

<style>
  .entry {
    padding: clamp(var(--space-lg), 5vw, var(--space-2xl)) clamp(var(--space-md), 4vw, var(--space-xl));
    display: flex;
    justify-content: center;
  }

  .entry__pane {
    width: 100%;
    max-width: 42rem;
    padding: clamp(var(--space-lg), 4vw, var(--space-xl));
  }

  .entry__prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0 0 var(--space-lg);
  }

  .entry__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--color-ink);
    margin: 0 0 var(--space-2xs);
    overflow-wrap: anywhere;
  }

  .entry__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    margin: 0 0 var(--space-xl);
  }

  .entry__date-sep {
    margin-inline: var(--space-2xs);
    color: var(--color-rule);
  }

  .entry__toc {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    padding: var(--space-md);
    margin: 0 0 var(--space-xl);
  }

  .entry__toc-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-muted);
    margin: 0 0 var(--space-xs);
  }

  .entry__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .entry__toc-item a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .entry__toc-item a:hover {
    color: var(--color-accent);
  }

  .entry__toc-item--depth-3 {
    padding-inline-start: var(--space-md);
  }

  .entry__body {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-ink);
    max-width: 65ch;
    margin-bottom: var(--space-xl);
  }

  .entry__body :global(p) {
    margin: 0 0 var(--space-md);
  }

  .entry__body :global(h2),
  .entry__body :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
    margin: var(--space-lg) 0 var(--space-sm);
  }

  .entry__body :global(ul),
  .entry__body :global(ol) {
    margin: 0 0 var(--space-md);
    padding-inline-start: 1.25em;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .entry__body :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .entry__body :global(a:hover) {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .entry__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    padding: 0.1em 0.4em;
  }

  .entry__body :global(pre) {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    padding: var(--space-md);
    padding-inline-end: calc(var(--space-md) + 2.25rem);
    overflow-x: auto;
    margin: 0 0 var(--space-md);
    /* Astro's markdown pipeline ships Shiki syntax highlighting as inline styles (its own
       fixed colour theme) on <pre> and every token <span> — overriding here keeps code
       blocks strictly monochrome instead of importing an unrelated colour palette. */
    background: var(--color-paper-2) !important;
    color: var(--color-ink) !important;
  }

  .entry__body :global(pre) :global(span) {
    color: inherit !important;
  }

  .entry__body :global(.entry__copy-btn) {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-muted);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .entry__body :global(.entry__copy-btn:hover) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .entry__body :global(.entry__copy-btn--error) {
    color: var(--color-destructive);
    border-color: var(--color-destructive);
  }

  .entry__body :global(.entry__copy-btn:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .entry__body :global(.entry__copy-btn:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .entry__body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .entry__body :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 40rem);
    max-height: 40rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    margin: 0 0 var(--space-md);
  }

  .entry__body :global(blockquote) {
    margin: 0 0 var(--space-md);
    padding-inline-start: var(--space-md);
    border-inline-start: 2px solid var(--color-rule);
    color: var(--color-ink-2);
  }

  .entry__back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .entry__back:hover {
    color: var(--color-accent);
  }

  .entry__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    border-block: 1px solid var(--color-rule);
    padding-block: var(--space-md);
    margin: 0 0 var(--space-lg);
  }

  .entry__pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .entry__pager-link--newer {
    text-align: end;
    align-items: flex-end;
  }

  .entry__pager-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .entry__pager-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  .entry__pager-link:hover .entry__pager-label,
  .entry__pager-link:hover .entry__pager-title {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .entry__pager {
      grid-template-columns: 1fr;
    }

    .entry__pager-link--newer {
      text-align: start;
      align-items: flex-start;
    }
  }
</style>
