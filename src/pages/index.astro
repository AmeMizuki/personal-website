---
import { getCollection } from 'astro:content'
import { ArrowRight } from '@lucide/vue'
import BaseLayout from '@/layouts/BaseLayout.astro'
import TextType from '@/components/TextType/TextType.vue'
import TerminalPrompt from '@/components/TerminalPrompt.vue'
import MusicPlayerSkin from '@/components/MusicPlayerSkin.vue'
import { Button } from '@/components/ui/button'
import { profile } from '@/data/profile'

const bootLines = [
  `booting ${profile.hostname}...`,
  `loading identity: ${profile.handle}`,
  'render target: ascii_background.pre — ok',
  'ready.',
]

const latest = (await getCollection('journal')).sort((a, b) => b.data.date - a.data.date).slice(0, 3)
---

<BaseLayout title="~/home">
  <div class="home">
    <section class="home-hero">
      <div class="home-hero__pane term-pane">
        <ol class="home-hero__boot">
          {
            bootLines.map((line, i) => (
              <li class="reveal" style={`--i: ${i}`}>
                <span class="home-hero__boot-glyph">&gt;</span>
                {line}
              </li>
            ))
          }
        </ol>

        <TerminalPrompt client:visible />

        <h1 class="home-hero__name reveal" style={`--i: ${bootLines.length}`}>{profile.name}</h1>

        <TextType
          client:visible
          class-name="home-hero__role"
          text={[`${profile.role}.`, 'terminal aesthete.', 'faulty by design.']}
          typing-speed={42}
          pause-duration={1600}
          deleting-speed={24}
          cursor-character="_"
          as="p"
        />

        <div class="home-hero__actions reveal" style={`--i: ${bootLines.length + 1}`}>
          <Button as-child variant="outline">
            <a href="/about">cat about.txt</a>
          </Button>
          <Button as-child variant="ghost">
            <a href="/journal">ls ~/journal</a>
          </Button>
        </div>
      </div>
    </section>

    <section class="home-player">
      <h2 class="home-player__heading"># now_playing</h2>
      <MusicPlayerSkin
        client:visible
        album="TIE HUA FEI / 鐵花飛"
        artist="Mili"
        cover="https://img.youtube.com/vi/acnx9QFbAp4/hqdefault.jpg"
      />
    </section>

    <section class="home-latest">
      <h2 class="home-latest__heading"># tail -n 3 ~/journal</h2>
      <ul class="home-latest__list">
        {
          latest.map((entry) => (
            <li class="home-latest__item">
              <a href={`/journal/${entry.id}`} class="home-latest__link">
                <span class="home-latest__date">{entry.data.date.toISOString().slice(0, 10)}</span>
                <span class="home-latest__title">{entry.data.title}</span>
                <span class="home-latest__arrow"><ArrowRight size={16} aria-hidden="true" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home-hero {
    min-height: calc(100dvh - 3.5rem);
    display: flex;
    align-items: flex-end;
    padding: clamp(var(--space-lg), 6vw, var(--space-3xl)) clamp(var(--space-md), 4vw, var(--space-xl));
  }

  .home-hero__pane {
    max-width: 40rem;
    padding: clamp(var(--space-lg), 4vw, var(--space-xl));
  }

  .home-hero__boot {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .home-hero__boot-glyph {
    color: var(--color-rule);
    margin-inline-end: var(--space-xs);
  }

  .home-hero__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display-s);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
    overflow-wrap: anywhere;
  }

  .home-hero :global(.home-hero__role) {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--color-ink-2);
    margin: 0 0 var(--space-xl);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .home-player {
    padding: var(--space-3xl) clamp(var(--space-md), 4vw, var(--space-xl)) 0;
    max-width: 48rem;
  }

  .home-player__heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    margin: 0 0 var(--space-md);
  }

  .home-latest {
    padding: var(--space-3xl) clamp(var(--space-md), 4vw, var(--space-xl)) var(--space-2xl);
    max-width: 48rem;
  }

  .home-latest__heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    margin: 0 0 var(--space-md);
  }

  .home-latest__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .home-latest__item {
    border-bottom: 1px solid var(--color-rule);
  }

  .home-latest__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    text-decoration: none;
    font-family: var(--font-mono);
    color: var(--color-ink);
    transition: color var(--dur-short) var(--ease-out);
  }

  .home-latest__link:hover {
    color: var(--color-accent);
  }

  .home-latest__date {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .home-latest__title {
    flex: 1;
    font-size: var(--text-sm);
  }

  .home-latest__arrow {
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .home-hero {
      align-items: center;
    }
    .home-hero__pane {
      width: 100%;
    }
  }
</style>
