---
import { ClientRouter } from 'astro:transitions'
import '@/styles/global.css'
import SiteBackground from '@/components/SiteBackground.vue'
import TerminalNav from '@/components/TerminalNav.vue'
import SiteFooter from '@/components/SiteFooter.vue'
import { profile } from '@/data/profile'
import SeoHead from '@/components/SeoHead.astro'
import { sitePath } from '@/lib/site-path'

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="zh-Hant" class="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — journal`} href={sitePath('/rss.xml')} />
    <SeoHead {...Astro.props} />
    <script is:inline>
      document.documentElement.dataset.loading = 'initial'
    </script>
    <ClientRouter />
  </head>
  <body>
    <div id="preloader" class="preloader" transition:persist>
      <p class="preloader__title" aria-hidden="true">
        {profile.name}<span class="preloader__cursor">▮</span>
      </p>
      <p class="preloader__status" role="status" data-i18n="page.loading">載入頁面中…</p>
    </div>
    <SiteBackground client:idle transition:persist />
    <TerminalNav client:load transition:persist currentPath={currentPath} />
    <main id="main-content" class="site-main" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    <SiteFooter client:visible transition:persist />
  </body>
</html>

<script>
  import { watch } from 'vue'
  import { startPageLoading, finishPageLoading, isPageLoading, currentPath } from '@/composables/pageStore'
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client'

  let activeSignal: AbortSignal | undefined
  let navigating = false

  function renderLoading() {
    document.documentElement.dataset.loading = isPageLoading.value ? 'navigation' : 'ready'
    document.querySelector('main')?.setAttribute('aria-busy', String(isPageLoading.value))
  }
  watch(isPageLoading, renderLoading, { flush: 'sync' })

  function finish() {
    activeSignal = undefined
    finishPageLoading(window.location.pathname)
    renderLoading()
  }

  document.addEventListener('astro:before-preparation', (event) => {
    const preparation = event as TransitionBeforePreparationEvent
    const signal = preparation.signal
    activeSignal = signal
    navigating = true
    startPageLoading()
    const cancel = () => {
      if (activeSignal === signal) {
        navigating = false
        finish()
      }
    }
    signal.addEventListener('abort', cancel, { once: true })
    const loader = preparation.loader
    preparation.loader = async () => {
      try {
        await loader()
        if (preparation.defaultPrevented || signal.aborted) cancel()
      } catch (error) {
        cancel()
        throw error
      }
    }
  })
  document.addEventListener('astro:after-swap', () => {
    currentPath.value = window.location.pathname
    renderLoading()
  })
  document.addEventListener('astro:page-load', () => {
    finish()
    if (navigating) document.querySelector<HTMLElement>('main')?.focus({ preventScroll: true })
    navigating = false
  })
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      navigating = false
      finish()
    }
  })
  // Server-rendered content is already usable; don't wait for third-party media.
  finish()
</script>

<script>
  // Applies the stored locale to server-rendered static text on every page —
  // Vue-island chrome (nav/footer/terminal/player) reacts on its own via the
  // shared composable (src/composables/i18nStore.js); this covers the plain
  // Astro-rendered strings marked with data-i18n in each page.
  import { t, getLocale } from '@/i18n/utils'

  function applyTranslations() {
    document.documentElement.lang = getLocale()
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const vars = el.dataset.i18nVars ? JSON.parse(el.dataset.i18nVars) : {}
      const value = t(el.dataset.i18n, vars)
      const attr = el.dataset.i18nAttr
      if (attr) el.setAttribute(attr, value)
      else el.textContent = value
    })
  }

  // Videos parsed in the router's inactive document need fresh resource selection.
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll<HTMLVideoElement>('.site-main video').forEach(video => video.load())
  })

  document.addEventListener('astro:page-load', applyTranslations)
  window.addEventListener('site-locale-changed', applyTranslations)
</script>

<style>
  .site-main {
    position: relative;
    z-index: var(--z-raised);
    min-height: calc(100dvh - 3.5rem);
    padding-block-start: 3.5rem;
  }

  .preloader {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-tooltip);
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background: var(--color-paper);
    pointer-events: none;
  }

  :global(html[data-loading='initial']) .preloader {
    display: flex;
    min-height: 100dvh;
  }

  :global(html[data-loading='navigation']) .preloader {
    inset-block-start: 3.5rem;
    display: flex;
    border-block-end: 2px solid var(--color-cursor);
    padding-block: var(--space-xs);
  }

  :global(html[data-loading='navigation']) .preloader__title {
    display: none;
  }

  .preloader__status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }


  .preloader__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display);
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .preloader__cursor {
    color: var(--color-cursor);
    animation: preloader-blink 1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader__cursor {
      animation: none;
    }
  }

  @keyframes preloader-blink {
    50% {
      opacity: 0;
    }
  }
</style>
